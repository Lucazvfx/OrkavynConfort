# =============================================================
# AgroRadar — variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o .env.
# =============================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=troque-por-uma-string-aleatoria-longa
# Senha do painel /admin (obrigatória para habilitar o admin na Etapa 2)
ADMIN_PASSWORD=troque-esta-senha

# --- Banco de dados ---
# Vazio = SQLite em instance/agroradar.db
# Supabase/PostgreSQL: postgresql+psycopg://user:senha@host:5432/postgres
DATABASE_URL=

# --- Inteligência Artificial (Boletim das 6h) ---
# auto  = usa o primeiro provedor configurado (gemini > openai > ollama) e cai para regras
# gemini | openai | ollama | rules
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=40

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Qualquer endpoint compatível com a API da OpenAI (OpenRouter, Groq, vLLM...)
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local: preencha OLLAMA_BASE_URL para o modo auto considerá-lo
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# --- Coleta ---
HTTP_TIMEOUT_SECONDS=20
# Lista opcional "Nome|URL" separada por vírgula. Vazio = feeds padrão do rss_collector.py
RSS_FEEDS=
NEWS_RETENTION_DAYS=60
WEATHER_FORECAST_DAYS=15

# --- Agendador (Etapa 2) ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo
BRIEFING_HOUR=6
